# Copy this file to .env and edit.
PORT=5000

# Frontend URL(s) allowed to connect. Separate several with commas.
# Local:       http://localhost:5173
# Production:  https://your-app.vercel.app
CORS_ORIGIN=http://localhost:5173

# MongoDB connection string. Quizzes are saved here.
# Atlas (free):  mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Local MongoDB: mongodb://127.0.0.1:27017
# The database name (brain-duel) is set in src/constants.js, do not add it here.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
